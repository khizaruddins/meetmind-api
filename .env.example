# Runtime Environment
NODE_ENV=development
PORT=3001

# PostgreSQL Database Connection String
# For Local Development (port 5433):
DATABASE_URL="postgresql://postgres@127.0.0.1:5433/meeting_recorder_dev?schema=public"
# For Vercel Serverless / Production (Neon, Supabase, Railway, AWS RDS with PgBouncer / Connection Pooler):
# DATABASE_URL="postgresql://postgres:[PASSWORD]@[HOST]:6543/postgres?pgbouncer=true&connection_limit=5"

# JWT Authentication Secrets
JWT_ACCESS_SECRET="your-access-secret-at-least-32-chars-long"
JWT_REFRESH_SECRET="your-refresh-secret-at-least-32-chars-long"
JWT_ACCESS_EXPIRATION="15m"
JWT_REFRESH_EXPIRATION="30d"

# Cryptographic Offline Entitlement HMAC Secret
OFFLINE_ENTITLEMENT_SECRET="your-offline-entitlement-hmac-secret-here"

# Web Frontend URL (for CORS allowance in production)
FRONTEND_URL="https://your-app.vercel.app"

# Payment Gateway (Razorpay & Stripe)
RAZORPAY_KEY_ID="rzp_test_..."
RAZORPAY_KEY_SECRET="..."
RAZORPAY_WEBHOOK_SECRET="..."
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Administrative Bootstrap (Local Dev Seed Only)
# In production on Vercel, set ADMIN_SEED_ENABLED=false
ADMIN_SEED_ENABLED="false"
ADMIN_SEED_EMAIL="admin@meetingrecorder.local"
ADMIN_SEED_PASSWORD="ChangeMeInProduction!"
ADMIN_SEED_NAME="Super Administrator"
